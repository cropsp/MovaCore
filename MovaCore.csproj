<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Resources\movacore.ico</ApplicationIcon>
    <RootNamespace>LayoutConverter.App</RootNamespace>
    <AssemblyName>MovaCore</AssemblyName>
    
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <!-- tests/ has its own project; keep its sources and obj/ out of the app's default globs -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    
    <Version>1.0.0</Version>
    <Authors>cropsp</Authors>
    <Description>Fast and polite keyboard layout converter for Windows</Description>
    <Copyright>Copyright © 2026 cropsp</Copyright>
    <PackageProjectUrl>https://github.com/cropsp/MovaCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cropsp/MovaCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- WinForms is not trim-annotated: its own trim warnings would drown ours, so they are audited in CI instead.
         _SuppressWinFormsTrimError bypasses NETSDK1175, which otherwise refuses to trim/AOT-publish WinForms. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpHook" Version="7.1.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- Loaded by AppResources.cs; generated from Resources\mouse_icon.png by eng/generate-icons.py -->
    <EmbeddedResource Include="Resources\movacore.ico" LogicalName="MovaCore.movacore.ico" />
    <EmbeddedResource Include="Resources\logo.png" LogicalName="MovaCore.logo.png" />
  </ItemGroup>
</Project>
