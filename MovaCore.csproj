<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Resources\movacore.ico</ApplicationIcon>
    <RootNamespace>MovaCore</RootNamespace>
    <AssemblyName>MovaCore</AssemblyName>
    
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <!-- tests/ has its own project; keep its sources and obj/ out of the app's default globs -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- Not InvariantGlobalization: WinForms creates a CultureInfo for the keyboard layout whenever the user switches
         layouts in one of our windows (WM_INPUTLANGCHANGE*), and invariant mode makes that throw. -->
    
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    
    <Version>1.2.0</Version>
    <Authors>cropsp</Authors>
    <Description>Fast and polite keyboard layout converter for Windows</Description>
    <Copyright>Copyright © 2026 cropsp</Copyright>
    <PackageProjectUrl>https://github.com/cropsp/MovaCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cropsp/MovaCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- _SuppressWinFormsTrimError bypasses NETSDK1175, which otherwise refuses to trim/AOT-publish WinForms.
         WinForms itself then produces AOT/trim/single-file warnings at publish (IL3053, IL2104, IL3000) that this
         project cannot fix, so they stay visible but do not fail the build (CI lists them in the job summary).
         Our own code is still covered: the Roslyn AOT/trim analyzers run at compile time, where warnings are errors. -->
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpHook" Version="7.1.3" />
    <!-- Dictation. Whisper.net 1.9.2 is the first version with RuntimeOptions.ForcedRuntimeLibrary, which Native AOT
         needs on x64 (its AVX check reads the compile-time baseline there). NAudio 3.1 is its first AOT-safe release. -->
    <PackageReference Include="Whisper.net" Version="1.9.2-preview1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.2-preview1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.2-preview1" />
    <PackageReference Include="NAudio.Wasapi" Version="[3.1.0]" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- Loaded by AppResources.cs; generated from Resources\mouse_icon.png by eng/generate-icons.py -->
    <EmbeddedResource Include="Resources\movacore.ico" LogicalName="MovaCore.movacore.ico" />
    <EmbeddedResource Include="Resources\movacore-recording.ico" LogicalName="MovaCore.movacore-recording.ico" />
    <EmbeddedResource Include="Resources\movacore-transcribing.ico" LogicalName="MovaCore.movacore-transcribing.ico" />
    <EmbeddedResource Include="Resources\logo.png" LogicalName="MovaCore.logo.png" />
  </ItemGroup>

  <!-- Which build this is, since testers run many builds of one version: CI passes its run number, commit and whether
       it builds a release tag (variables GitHub Actions sets); a local build has none of them. BuildInfo.g.cs carries
       them as constants (no reflection to survive AOT) for the settings header, About and the log's first line, and the
       run number is the file version's fourth part (Explorer: Properties, Details). -->
  <PropertyGroup>
    <MovaCoreBuildNumber>$(GITHUB_RUN_NUMBER)</MovaCoreBuildNumber>
    <MovaCoreBuildCommit Condition="'$(GITHUB_SHA)' != ''">$(GITHUB_SHA.Substring(0, 7))</MovaCoreBuildCommit>
    <MovaCoreReleaseBuild>false</MovaCoreReleaseBuild>
    <MovaCoreReleaseBuild Condition="'$(GITHUB_REF_TYPE)' == 'tag'">true</MovaCoreReleaseBuild>
    <FileVersion Condition="'$(MovaCoreBuildNumber)' != ''">$(Version).$(MovaCoreBuildNumber)</FileVersion>
  </PropertyGroup>

  <Target Name="WriteBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_BuildInfoPath>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildInfoPath>
      <_BuildInfoText>
// &lt;auto-generated/&gt; by the WriteBuildInfo target in MovaCore.csproj
namespace MovaCore
{
    /// &lt;summary&gt;Which build this is: CI's run number and commit, both empty for a local build.&lt;/summary&gt;
    internal static class BuildInfo
    {
        public static string Number =&gt; "$(MovaCoreBuildNumber)";
        public static string Commit =&gt; "$(MovaCoreBuildCommit)";
        public static string Date =&gt; "$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))";
        public static bool Release =&gt; $(MovaCoreReleaseBuild);
    }
}
      </_BuildInfoText>
    </PropertyGroup>
    <!-- Escaped, or the semicolons would split the text into separate lines -->
    <WriteLinesToFile File="$(_BuildInfoPath)" Lines="$([MSBuild]::Escape($(_BuildInfoText.Trim())))" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_BuildInfoPath)" />
      <FileWrites Include="$(_BuildInfoPath)" />
    </ItemGroup>
  </Target>

  <!-- The Whisper.net runtime packages copy their native files for every architecture (and Vulkan's for Linux too),
       whatever the RuntimeIdentifier is: keep only the published architecture's. -->
  <Target Name="RemoveForeignWhisperRuntimes" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_ForeignWhisperRuntime Include="$(PublishDir)runtimes\win-x86" />
      <_ForeignWhisperRuntime Include="$(PublishDir)runtimes\vulkan\linux-x64" />
      <_ForeignWhisperRuntime Include="$(PublishDir)runtimes\win-arm64" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
      <_ForeignWhisperRuntime Include="$(PublishDir)runtimes\win-x64" Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
      <!-- Whisper.net has no Vulkan build for ARM -->
      <_ForeignWhisperRuntime Include="$(PublishDir)runtimes\vulkan" Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
    </ItemGroup>
    <RemoveDir Directories="@(_ForeignWhisperRuntime)" />
  </Target>
</Project>
