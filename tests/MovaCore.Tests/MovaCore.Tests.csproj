    <Compile Include="../../Services/IClipboardService.cs" Link="Linked/IClipboardService.cs" />
    <Compile Include="../../Services/ClipboardSnapshot.cs" Link="Linked/ClipboardSnapshot.cs" />
    <Compile Include="../../Services/SettingsService.cs" Link="Linked/SettingsService.cs" />
    <Compile Include="../../Services/IStartupRegistration.cs" Link="Linked/IStartupRegistration.cs" />
    <Compile Include="../../Services/AppLog.cs" Link="Linked/AppLog.cs" />
    <Compile Include="../../Services/FileLog.cs" Link="Linked/FileLog.cs" />
    <Compile Include="../../Models/AppSettings.cs" Link="Linked/AppSettings.cs" />
    <Compile Include="../../Models/Hotkey.cs" Link="Linked/Hotkey.cs" />
    <Compile Include="../../Models/HotkeyModifiers.cs" Link="Linked/HotkeyModifiers.cs" />
    <Compile Include="../../Models/CopyPasteKeys.cs" Link="Linked/CopyPasteKeys.cs" />
