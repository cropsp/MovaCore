<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>MovaCore.Tests</RootNamespace>
  </PropertyGroup>

  <!-- The app targets net10.0-windows (WinForms) and cannot be referenced from a cross-platform test project,
       so the platform-neutral service sources are compiled in directly. -->
