<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>MovaCore.Tests</RootNamespace>
  </PropertyGroup>

  <!-- The app targets net8.0-windows (WinForms) and cannot be referenced from a cross-platform test project,
       so the platform-neutral service sources are compiled in directly. -->
  <ItemGroup>
    <Compile Include="../../Services/ILayoutConverterService.cs" Link="Linked/ILayoutConverterService.cs" />
    <Compile Include="../../Services/HotkeyOrchestrator.cs" Link="Linked/HotkeyOrchestrator.cs" />
    <Compile Include="../../Services/IHotkeyService.cs" Link="Linked/IHotkeyService.cs" />
    <Compile Include="../../Services/ClipboardService.cs" Link="Linked/ClipboardService.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpHook" Version="5.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
